# Specify filepatterns you want git to ignore.

node_modules
_site
.DS_Store
.cache
src/assets/*
!src/assets/icons/
!src/assets/icons/**
!src/assets/site.js
# Page imagery we intentionally ship (allowlisted individually so bulk/scratch
# images under src/assets/images/ stay ignored).
!src/assets/images/
src/assets/images/*
!src/assets/images/retreat-hero.jpg
!src/assets/images/retreat-hero-sm.jpg
.env
.obsidian/
src/obsidian/.obsidian/
src/cta-wiki/.smart-env
# Claude local state stays ignored, but .claude/skills/ is versioned (repo-owned skills, e.g. /cta-page)
.claude/*
!.claude/skills/

# Netlify CLI local state
.netlify
