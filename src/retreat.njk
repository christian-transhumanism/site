<script>
  // Photo slider arrows. The track scrolls natively (swipe, trackpad, arrow
  // keys) with no JS at all — these buttons are purely additive, so they stay
  // hidden until we know scripting is available.
  (function () {
    var track = document.querySelector("[data-gallery-track]");
    var prev = document.querySelector("[data-gallery-prev]");
    var next = document.querySelector("[data-gallery-next]");
    if (!track || !prev || !next) {
      return;
    }

    function maxScroll() {
      return track.scrollWidth - track.clientWidth;
    }

    function sync() {
      var atStart = track.scrollLeft <= 1;
      var atEnd = track.scrollLeft >= maxScroll() - 1;
      var scrollable = maxScroll() > 1;
      prev.hidden = !scrollable || atStart;
      next.hidden = !scrollable || atEnd;
    }

    function itemWidth() {
      var first = track.querySelector(".retreat-gallery__item");
      return first ? first.getBoundingClientRect().width : 0;
    }

    // Scroll to an exact item boundary rather than by a fraction of the
    // viewport: a mandatory snap container will fight a target that lands
    // between snap points. Honour reduced-motion here too, since an explicit
    // `behavior` overrides the CSS scroll-behavior rule.
    function page(direction) {
      var width = itemWidth();
      if (!width) {
        return;
      }
      var perPage = Math.max(1, Math.floor(track.clientWidth / width));
      var current = Math.round(track.scrollLeft / width);
      var target = Math.max(0, current + direction * perPage) * width;
      var reduced = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      track.scrollTo({ left: Math.min(target, maxScroll()), behavior: reduced ? "auto" : "smooth" });
    }

    prev.addEventListener("click", function () { page(-1); });
    next.addEventListener("click", function () { page(1); });
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
    sync();
  })();
</script>
